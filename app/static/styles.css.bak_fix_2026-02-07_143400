:root{
  --bg0: #05080f;
  --bg1: #0b1220;
  --panel: rgba(255,255,255,0.05);
  --panel2: rgba(255,255,255,0.08);
  --stroke: rgba(255,255,255,0.10);
  --text: rgba(255,255,255,0.92);
  --muted: rgba(255,255,255,0.60);

  --good: #22c55e;
  --warn: #f59e0b;
  --bad:  #ef4444;

  --cyan: #22d3ee;
  --blue: #60a5fa;
  --violet: #a78bfa;
  --pink: #fb7185;

  --glow: 0 0 24px rgba(96,165,250,0.20);
}

* { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }

.app-bg{
  background:
    radial-gradient(1100px 650px at 15% -10%, rgba(34,211,238,0.18), transparent 60%),
    radial-gradient(900px 550px at 85% 10%, rgba(167,139,250,0.16), transparent 55%),
    radial-gradient(900px 500px at 70% 110%, rgba(34,197,94,0.10), transparent 55%),
    linear-gradient(180deg, var(--bg0), var(--bg1));
  color: var(--text);
  min-height: 100vh;
}

.topbar{
  background: rgba(0,0,0,0.45);
  border-bottom: 1px solid var(--stroke);
  position: sticky;
  top: 0;
  z-index: 20;
  backdrop-filter: blur(12px);
}

.brand{ font-weight: 800; letter-spacing: 0.2px; }
.bolt{ filter: drop-shadow(0 0 14px rgba(255,255,255,0.18)); }
.smallnote{ color: var(--muted); font-size: 12px; }
.muted{ color: var(--muted); }

.pill{
  font-size: 11px;
  padding: 3px 10px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.05);
}

.cardx{
  background:
    radial-gradient(600px 240px at 10% 0%, rgba(96,165,250,0.12), transparent 55%),
    radial-gradient(450px 220px at 90% 20%, rgba(34,211,238,0.10), transparent 55%),
    linear-gradient(180deg, rgba(255,255,255,0.07), rgba(255,255,255,0.04));
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: 18px;
  box-shadow: 0 14px 44px rgba(0,0,0,0.55);
}

.minerCard{
  position: relative;
  overflow: hidden;
}
.minerCard::before{
  content:"";
  position:absolute;
  inset:-2px;
  background: radial-gradient(600px 200px at 20% 0%, rgba(34,211,238,0.16), transparent 55%),
              radial-gradient(500px 220px at 90% 10%, rgba(167,139,250,0.14), transparent 55%);
  opacity: 0.55;
  pointer-events:none;
}

.kpi{ display:flex; gap: 12px; flex-wrap: wrap; justify-content: center; align-items: stretch; }

.kpi .box{
  min-width: 260px;
  text-align: center;
  padding: 14px 16px;
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,0.12);
  background: rgba(255,255,255,0.05);
  box-shadow: var(--glow);
}
.kpi .val{
  font-size: 24px;
  font-weight: 900;
  letter-spacing: 0.2px;
  text-shadow: 0 0 18px rgba(255,255,255,0.06);
}
.kpi .lbl{ color: var(--muted); font-size: 12px; }

.badge-dot{
  width: 10px; height: 10px; border-radius: 50%;
  display:inline-block;
  box-shadow: 0 0 22px rgba(34,197,94,0.35);
}
.dot-good{ background: var(--good); }
.dot-warn{ background: var(--warn); box-shadow: 0 0 20px rgba(245,158,11,0.35); }
.dot-bad { background: var(--bad);  box-shadow: 0 0 20px rgba(239,68,68,0.35); }

.minerTitle{
  font-weight: 950;
  font-size: 18px;
  letter-spacing: 0.2px;
}
a{ color: var(--blue); }
a:hover{ opacity: 0.92; }

.mini{
  border: 1px solid rgba(255,255,255,0.10);
  background: rgba(0,0,0,0.18);
  border-radius: 16px;
  padding: 11px 12px;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
}
.mini .t{ color: var(--muted); font-size: 12px; }
.mini .v{
  font-weight: 900;
  font-size: 16px;
  text-shadow: 0 0 18px rgba(96,165,250,0.10);
}

.chartwrap{
  margin-top: 8px;
  border-radius: 16px;
  padding: 10px 10px 6px 10px;
  background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
  border: 1px solid rgba(255,255,255,0.10);
  box-shadow: 0 0 24px rgba(34,211,238,0.08);
}

.pbar{
  height: 12px;
  width: 100%;
  background: rgba(255,255,255,0.08);
  border-radius: 999px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.10);
}
.pbarFill{
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, rgba(34,211,238,0.95), rgba(96,165,250,0.95), rgba(34,197,94,0.90));
  filter: drop-shadow(0 0 12px rgba(34,211,238,0.18));
  transition: width 0.25s ease;
}
.pbarFill.warn{
  background: linear-gradient(90deg, rgba(245,158,11,0.95), rgba(239,68,68,0.95));
}

hr.sep{ border-color: rgba(255,255,255,0.10); opacity: 1; }

.seg{
  display: inline-flex;
  border: 1px solid rgba(255,255,255,0.16);
  border-radius: 999px;
  overflow: hidden;
  box-shadow: 0 0 18px rgba(167,139,250,0.12);
}
.segbtn{
  background: rgba(255,255,255,0.05);
  border: 0;
  color: rgba(255,255,255,0.86);
  padding: 6px 10px;
  font-size: 12px;
}
.segbtn.active{
  background: linear-gradient(90deg, rgba(34,211,238,0.20), rgba(167,139,250,0.18));
  color: rgba(255,255,255,0.98);
}

.compactBtn{
  border-color: rgba(255,255,255,0.25) !important;
}

/* Mobile + compact */
@media (max-width: 600px){
  body{ font-size: 14px; }
  .kpi .box{ min-width: 170px; padding: 10px 12px; }
  .kpi .val{ font-size: 20px; }
  .minerTitle{ font-size: 16px; }
}
body.compact .kpi .box{ min-width: 180px; padding: 10px 12px; }
body.compact .kpi .val{ font-size: 20px; }
body.compact .mini{ padding: 9px 10px; }

/* ===== best diff badges ===== */
.bestBadge{
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-weight: 900;
  padding: 2px 10px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.14);
  background: rgba(255,255,255,0.04);
}
.bestT{ background: rgba(245,158,11,0.14); border-color: rgba(245,158,11,0.35); box-shadow: 0 0 18px rgba(245,158,11,0.18); }
.bestB{ background: rgba(167,139,250,0.14); border-color: rgba(167,139,250,0.35); box-shadow: 0 0 18px rgba(167,139,250,0.18); }
.bestM{ background: rgba(96,165,250,0.14);  border-color: rgba(96,165,250,0.35);  box-shadow: 0 0 18px rgba(96,165,250,0.18); }
.bestK{ background: rgba(34,197,94,0.14);   border-color: rgba(34,197,94,0.35);   box-shadow: 0 0 18px rgba(34,197,94,0.18); }


/* ===== coin rain (shares) ===== */
.coin-layer{
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  border-radius: 18px; /* żeby nie wychodziło poza kartę */
}

.coin{
  position: absolute;
  top: -24px;
  font-weight: 900;
  color: rgba(245, 158, 11, 0.95);
  text-shadow: 0 0 18px rgba(245, 158, 11, 0.35);
  filter: drop-shadow(0 0 10px rgba(245, 158, 11, 0.22));
  user-select: none;
  animation: coinFall var(--dur, 1.6s) linear forwards;
}

.coin::after{
  content: "₿";
}

@keyframes coinFall{
  0%   { transform: translate(var(--dx, 0px), -10px) rotate(0deg);   opacity: 0; }
  10%  { opacity: 1; }
  100% { transform: translate(var(--dx, 0px), 430px) rotate(520deg); opacity: 0; }
}

10%{ opacity:1; }
  100%{ transform: translate(var(--dx,0px), 360px) rotate(220deg); opacity:0; }
}

10%{ opacity:1; }
  100%{ transform: translate(var(--dx,0px), 360px) rotate(220deg); opacity:0; }
}


/* === COIN_CSS_START === */
/* --- coin rain --- */
.minerCard{ position: relative; overflow: hidden; }
.coin-layer{ position:absolute; inset:0; pointer-events:none; overflow:hidden; z-index:50; }
.coin{ position:absolute; top:-24px; opacity:.95; filter:drop-shadow(0 6px 10px rgba(0,0,0,.45)); animation: coinFall var(--dur,1.6s) ease-in forwards; }
.coin::before{ content:"₿"; }
@keyframes coinFall{
  0%{ transform: translate(var(--dx,0px), -10px) rotate(0deg); opacity:0; }
  10%{ opacity:1; }
  100%{ transform: translate(var(--dx,0px), 360px) rotate(220deg); opacity:0; }
}
/* === COIN_CSS_END === */

